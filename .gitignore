# Worktrees（並行作業用）
worktrees/

# データディレクトリ（共有データは追跡しない）
data/shared/**
!data/shared/.gitkeep
data/local/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# ルート直下のみ（裸の lib/ は scripts/lib/ 等も無言で除外してしまう）
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Models and checkpoints
*.pt
*.pth
*.ckpt
*.h5
*.pb
*.onnx

# Large data files
*.parquet
*.arrow
*.feather
*.hdf5

# Secrets
.env
.env.local
*.key
credentials.json

# Claude Code local settings
.claude/settings.local.json

# model-policy の一時的な無効化（resolve-model.sh --disable/--enable の書き込み先）
.claude/model-policy.local.json

# /template-sync がローカル改変を退避したディレクトリ（一時的な作業用）
# コミットはしないが、/template-contribute の**検出対象**なので削除しないこと。
# 還流（またはテンプレートへの反映不要と判断）が済んでから手で削除する。
.claude/rules/template.bak-*/
